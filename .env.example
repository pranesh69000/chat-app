PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
OTP_EXPIRY_MINUTES=5

# AWS DynamoDB (Set to true once you create the table in AWS Console)
USE_DYNAMODB=false
DYNAMODB_TABLE_NAME=PrivateChatAppTable
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Cloudflare R2 Storage (10 GB permanently free)
USE_R2=false
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=private-chat-media
